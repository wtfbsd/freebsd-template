# The stand-in "Install" icon of the live desktop (rc.d/live_session puts it
# on the desktop of the live user; install-into-stage.sh replaces it).
[Desktop Entry]
Type=Application
Name=Install @DISTRO_NAME@
Comment=Install @DISTRO_NAME@ on a disk of this machine
Exec=/usr/local/bin/wtfbsd-installer
Icon=system-software-install
Terminal=false
Categories=System;

#!/bin/sh
#
# firstboot_user — provision the operator user + SSH keys on the first boot.
#
# Copyright (c) 2026 The wtfbsd contributors. BSD-2-Clause (see LICENSE).
#
# build.sh locks root in the image (the stock distribution leaves it with
# an EMPTY password), so login happens through an operator-provisioned
# account with SSH keys. rc(8) runs scripts carrying the "firstboot"
# KEYWORD only while /firstboot exists and removes the sentinel after
# processing — the sentinel is what build.sh touches into the stage.
#
# /boot/firstboot-user.conf (path overridable via the firstboot_user_conf
# rc variable) is read as KEY=value lines, parsed one line at a time and
# NEVER sourced: the file is operator data and may contain a crypt(3)
# password hash.
#
#   USERNAME=alice        ^[a-z_][a-z0-9_-]{0,31}$           (required)
#   FULLNAME=Alice        no ':' and no control characters   (optional)
#   SSH_KEY=ssh-...       one authorized_keys line, repeatable
#   PASSWORD_HASH=$6$...  crypt(3) starting with $6$ or $2b$ (optional)
#   WHEEL=yes|no          default yes
#
# With a PASSWORD_HASH the hash is fed to pw(8) over stdin; without one
# the password stays '*' (the pw useradd default) so SSH key login works.
# pw lock is WRONG here: a locked account cannot ssh at all.
#
# doas: WHEEL=yes puts the user in wheel; the overlay ships
# /usr/local/etc/doas.conf with "permit persist :wheel".
#
# On success the conf is renamed to <conf>.done and chmod 600 (it may
# contain a password hash).

# PROVIDE: firstboot_user
# REQUIRE: FILESYSTEMS NETWORKING
# BEFORE: LOGIN
# KEYWORD: firstboot nojail

. /etc/rc.subr

name=firstboot_user
rcvar=firstboot_user_enable

: ${firstboot_user_enable:="YES"}
: ${firstboot_user_conf:="/boot/firstboot-user.conf"}
load_rc_config "$name"

note() { # note <msg> — to the console and to syslog
	echo "firstboot_user: $*"
	logger -t firstboot_user "$*"
}

root_writable() { # root_writable — is the root filesystem writable?
	# the live image is mounted read-only: access(2) answers EROFS
	[ -w /etc ]
}

# fbu_owned_by <path> <uid>... — is <path> itself (a symbolic link is not
# followed) owned by one of the uids? An empty uid matches nothing.
fbu_owned_by() {
	_ob_p=$1
	shift
	_ob_u=$(ls -ldn "$_ob_p" 2> /dev/null | awk '{ print $3 }')
	[ -n "$_ob_u" ] || return 1
	for _ob_w in "$@"; do
		if [ -n "$_ob_w" ] && [ "$_ob_u" = "$_ob_w" ]; then
			return 0
		fi
	done
	return 1
}

# safe_ancestors <path> — can nobody but root (or the user that runs
# this) redirect <path> through a directory above it? A check of the last
# component alone is not enough: a symbolic link, or a directory another
# user can write to, anywhere above it sends mkdir -p and every write
# somewhere else. Two walks, from /:
#   - the path as written: a component that is a symbolic link must
#     belong to root (FreeBSD ships /home as a link of root to usr/home,
#     which is fine; a link anyone else made is refused). The walk stops
#     at the first component that does not exist yet.
#   - the physical path of the deepest component that exists (cd -P):
#     every directory must belong to root or to the user that runs this,
#     and must not be writable by others unless it is sticky (/tmp).
# Owner and mode are read with find(1) -user and -perm, which never
# follow a link and need no parsing of ls(1). On a refusal _sa_why says
# which component and why.
safe_ancestors() { # safe_ancestors <path>
	_sa_why=''
	_sa_left=${1#/}
	_sa_p=''
	_sa_last=/
	while :; do
		case $_sa_left in
		*/*)
			_sa_c=${_sa_left%%/*}
			_sa_left=${_sa_left#*/}
			;;
		*) break ;;
		esac
		[ -n "$_sa_c" ] || continue
		_sa_p="$_sa_p/$_sa_c"
		if [ -L "$_sa_p" ]; then
			if [ -z "$(find "$_sa_p" -prune -user 0 -print 2> /dev/null)" ]; then
				_sa_why="$_sa_p is a symbolic link that root does not own"
				return 1
			fi
		elif [ ! -e "$_sa_p" ]; then
			break
		fi
		_sa_last=$_sa_p
	done
	if ! _sa_phys=$(cd -P "$_sa_last" 2> /dev/null && pwd -P); then
		_sa_why="$_sa_last cannot be entered"
		return 1
	fi
	_sa_d=/
	_sa_left=${_sa_phys#/}
	while :; do
		if ! [ -O "$_sa_d" ] && [ -z "$(find "$_sa_d" -prune -user 0 -print 2> /dev/null)" ]; then
			_sa_why="$_sa_d belongs to neither root nor the user that runs this"
			return 1
		fi
		if [ -n "$(find "$_sa_d" -prune -perm -0002 ! -perm -1000 -print 2> /dev/null)" ]; then
			_sa_why="others can write to $_sa_d"
			return 1
		fi
		[ -n "$_sa_left" ] || break
		_sa_c=${_sa_left%%/*}
		case $_sa_left in
		*/*) _sa_left=${_sa_left#*/} ;;
		*) _sa_left='' ;;
		esac
		_sa_d="${_sa_d%/}/$_sa_c"
	done
	return 0
}

# fbu_install_keys <user> <home> <keys> — write <keys> to
# <home>/.ssh/authorized_keys for <user> without following a symbolic
# link. The home directory may already exist (an account that was made
# before, a home left on the disk), and whoever owns it can plant a link
# there: root would then write, chmod and chown the file the link names.
# So: no directory above the home may be redirected (safe_ancestors);
# the home, .ssh and authorized_keys must not be symbolic links and
# must belong to root (the uid that runs this script) or to the user;
# .ssh is entered once, its physical path is checked, it belongs to root
# while the keys go in, and every later name is relative to it. The keys
# go to a file mktemp creates in .ssh, which is renamed over
# authorized_keys (a rename replaces a link, it never follows it), and
# chown -h never follows a link either. Anything else is refused and
# said.
fbu_install_keys() {
	_ik_user=$1
	_ik_home=$2
	_ik_keys=$3
	_ik_ssh="$_ik_home/.ssh"
	_ik_me=$(id -u)
	_ik_uid=$(id -u "$_ik_user" 2> /dev/null) || _ik_uid=''
	if ! safe_ancestors "$_ik_home"; then
		note "refused to install the SSH keys of $_ik_user: $_sa_why"
		return 1
	fi
	for _ik_p in "$_ik_home" "$_ik_ssh" "$_ik_ssh/authorized_keys"; do
		if [ -L "$_ik_p" ]; then
			note "refused to install the SSH keys of $_ik_user: $_ik_p is a symbolic link"
			return 1
		fi
		if [ -e "$_ik_p" ] && ! fbu_owned_by "$_ik_p" 0 "$_ik_me" "$_ik_uid"; then
			note "refused to install the SSH keys of $_ik_user: $_ik_p belongs to neither root nor $_ik_user"
			return 1
		fi
	done
	if [ ! -d "$_ik_home" ] && ! mkdir -p "$_ik_home"; then
		note "cannot create $_ik_home"
		return 1
	fi
	if [ ! -e "$_ik_ssh" ] && ! (umask 077 && mkdir "$_ik_ssh"); then
		note "cannot create $_ik_ssh"
		return 1
	fi
	(
		umask 077
		if [ -L "$_ik_ssh" ] || ! cd -P "$_ik_ssh" 2> /dev/null; then
			note "refused to install the SSH keys of $_ik_user: $_ik_ssh is a symbolic link or not a directory"
			exit 1
		fi
		_ik_want=$(cd -P "$_ik_home" && pwd -P) || exit 1
		if [ "$(pwd -P)" != "$_ik_want/.ssh" ]; then
			note "refused to install the SSH keys of $_ik_user: $_ik_ssh moved while it was checked"
			exit 1
		fi
		if ! chown -h 0 . || ! chmod 700 .; then
			note "cannot take $_ik_ssh over for the write"
			exit 1
		fi
		if [ -L authorized_keys ]; then
			note "refused to install the SSH keys of $_ik_user: $_ik_ssh/authorized_keys is a symbolic link"
			exit 1
		fi
		if ! _ik_tmp=$(mktemp authorized_keys.XXXXXXXX); then
			note "cannot create a temporary file in $_ik_ssh"
			exit 1
		fi
		if ! printf '%s\n' "$_ik_keys" > "$_ik_tmp" || ! chmod 600 "$_ik_tmp" ||
			! mv -f "$_ik_tmp" authorized_keys; then
			rm -f "$_ik_tmp"
			note "failed to write $_ik_ssh/authorized_keys"
			exit 1
		fi
		if ! chown -h "$_ik_user" authorized_keys .; then
			note "cannot give $_ik_ssh to $_ik_user"
			exit 1
		fi
	)
}

firstboot_user_start() {
	local _conf="$firstboot_user_conf"
	local _k _l _v _user _full _keys _nkeys _hash _wheel _home _n
	if ! root_writable; then
		echo 'firstboot_user: read-only root (live media), skipped'
		return 0
	fi
	if [ ! -f "$_conf" ]; then
		echo 'firstboot_user: no first-boot user was provisioned.'
		echo '  root is locked. To get a login account, do ONE of:'
		echo '    * write the first-boot config /boot/firstboot-user.conf with'
		echo '      USERNAME=<name> and SSH_KEY=<an authorized_keys line>, then reboot'
		echo '    * boot the install ISO and run the on-disk install utility as root'
		echo '    * rebuild the image with: build.sh -u USER -k PUBKEYFILE'
		return 0
	fi

	# pass 1: parse + validate EVERYTHING before touching the system
	_user=''
	_full=''
	_keys=''
	_nkeys=0
	_hash=''
	_wheel='yes'
	while IFS= read -r _l || [ -n "$_l" ]; do
		case $_l in
		'' | '#'*) continue ;;
		[A-Z_]*=*) ;;
		*)
			note "not a KEY=value line: $_l"
			return 1
			;;
		esac
		_k=${_l%%=*}
		_v=${_l#*=}
		case $_k in
		USERNAME)
			if ! printf '%s\n' "$_v" | grep -Eq '^[a-z_][a-z0-9_-]{0,31}$'; then
				note 'USERNAME must match ^[a-z_][a-z0-9_-]{0,31}$'
				return 1
			fi
			_user=$_v
			;;
		FULLNAME)
			case $_v in
			*:*)
				note 'FULLNAME may not contain ":"'
				return 1
				;;
			esac
			if [ -n "$(printf '%s' "$_v" | grep -E '[[:cntrl:]]')" ]; then
				note 'FULLNAME may not contain control characters'
				return 1
			fi
			_full=$_v
			;;
		SSH_KEY)
			case $_v in
			ssh-ed25519* | ssh-rsa* | ecdsa-sha2-nistp256* | ecdsa-sha2-nistp384* | ecdsa-sha2-nistp521* | sk-ssh-ed25519@openssh.com* | sk-ecdsa-sha2-nistp256@openssh.com*) ;;
			*)
				note 'SSH_KEY must be one authorized_keys line starting with ssh-ed25519, ssh-rsa, ecdsa-sha2-nistp256/384/521 or an sk-*@openssh.com type'
				return 1
				;;
			esac
			_keys="$_keys
$_v"
			_nkeys=$((_nkeys + 1))
			;;
		PASSWORD_HASH)
			case $_v in
			'$6$'* | '$2b$'*) ;;
			*)
				note 'PASSWORD_HASH must be a crypt(3) string starting with $6$ or $2b$'
				return 1
				;;
			esac
			_hash=$_v
			;;
		WHEEL)
			case $_v in
			yes | no) ;;
			*)
				note "WHEEL must be yes or no (got: $_v)"
				return 1
				;;
			esac
			_wheel=$_v
			;;
		*)
			note "unknown key in $_conf: $_k"
			return 1
			;;
		esac
	done < "$_conf"

	if [ -z "$_user" ]; then
		note 'USERNAME is missing'
		return 1
	fi
	if [ "$_nkeys" -lt 1 ] && [ -z "$_hash" ]; then
		note 'at least one SSH_KEY line or a PASSWORD_HASH is required'
		return 1
	fi

	# pass 2: apply
	if ! pw usershow -n "$_user" > /dev/null 2>&1; then
		set -- -n "$_user" -c "${_full:-$_user}" -s /bin/sh -m
		if [ "$_wheel" = yes ]; then
			set -- "$@" -G wheel
		fi
		if ! pw useradd "$@"; then
			note "pw useradd $_user failed"
			return 1
		fi
		note "created user $_user (shell /bin/sh, wheel=$_wheel)"
	fi

	if [ -n "$_hash" ]; then
		# pw(8) -H 0: read the encrypted password from stdin so the hash
		# never appears in argv or in the command line
		if printf '%s\n' "$_hash" | pw usermod -n "$_user" -H 0; then
			note "password hash applied to $_user"
		else
			note "pw usermod -H 0 failed for $_user"
			return 1
		fi
	else
		# no hash: the password stays '*' — key login works, and the
		# account is deliberately NOT pw-locked: locked accounts cannot
		# ssh at all.
		note "no PASSWORD_HASH: password of $_user stays '*' (key-only login)"
	fi

	# /etc/passwd is 7 fields: the home directory is field 6
	# (the FULLNAME value is validated to never contain ':', so -F: is safe)
	_home=$(u="$_user" awk -F: '$1 == ENVIRON["u"] { print $6 }' /etc/passwd)
	case $_home in
	/*) ;;
	*) _home="/home/$_user" ;;
	esac
	if ! fbu_install_keys "$_user" "$_home" "${_keys#?}"; then
		return 1
	fi
	note "installed $_nkeys SSH key(s) for $_user at $_home/.ssh/authorized_keys"

	# key-only wheel user (no password to type): let doas accept the
	# SSH-authenticated session, otherwise the account could never get root
	if [ "$_wheel" = yes ] && [ -z "$_hash" ] && [ -f /usr/local/etc/doas.conf ]; then
		printf 'permit nopass %s\n' "$_user" >> /usr/local/etc/doas.conf
		note "doas: key-only wheel user $_user may run commands as root without a password"
	fi

	if mv "$_conf" "$_conf.done" && chmod 600 "$_conf.done"; then
		note "first-boot provisioning complete (conf moved to $_conf.done)"
	else
		note "could not move $_conf out of the way (user $_user is set up)"
		return 1
	fi
	return 0
}

start_cmd=firstboot_user_start

run_rc_command "$1"

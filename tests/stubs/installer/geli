#!/bin/sh
# geli — test stub for geli(8).
#
# Copyright (c) 2026 The wtfbsd contributors. BSD-2-Clause (see LICENSE).
#
# Logs its arguments to $STUB_LOG and changes nothing on a disk.
#
# With $STUB_GEOM (the device directory of the run, see the gpart stub) it
# keeps the providers it attached, in $STUB_GEOM/.geli/<name>, one line
# "<name> <partition>", and the <name>.eli node next to the label. Every
# init and attach also logs "geli-target <verb> <partition>": the partition
# the device name resolved to, so a test sees which disk was really used.
# `geli status -s` lists the attached providers; `geli detach` refuses one
# a pool still uses. $STUB_GELI_FAIL (an ERE) makes a matching call fail.

printf 'geli %s\n' "$*" >> "${STUB_LOG:-/dev/null}"
if [ -n "${STUB_GELI_FAIL:-}" ] && printf '%s\n' "$*" | grep -Eq -- "$STUB_GELI_FAIL"; then
	echo "geli: injected failure" >&2
	exit 1
fi
[ -n "${STUB_GEOM:-}" ] || exit 0
_G=$STUB_GEOM
for _a in "$@"; do _last=$_a; done
_n=${_last#/dev/}
_n=${_n%.eli}
# the partition behind a device name: a label resolves through GEOM
_prov() {
	case $1 in
	*/*)
		[ -f "$_G/.labels/${1#gpt/}" ] || return 1
		cat "$_G/.labels/${1#gpt/}"
		;;
	*) printf '%s\n' "$1" ;;
	esac
}
_key=$(printf '%s' "$_n" | tr '/' '_')
case $1 in
init | attach)
	_p=$(_prov "$_n") || { echo "geli: No such device: /dev/$_n" >&2; exit 1; }
	printf 'geli-target %s %s\n' "$1" "$_p" >> "${STUB_LOG:-/dev/null}"
	if [ "$1" = attach ]; then
		mkdir -p "$_G/.geli" "$_G/${_n%/*}"
		printf '%s %s\n' "$_n" "$_p" > "$_G/.geli/$_key"
		printf '%s\n' "$_p" > "$_G/$_n.eli"
	fi
	;;
detach)
	[ -f "$_G/.geli/$_key" ] || { echo "geli: No such device: $_n.eli" >&2; exit 1; }
	if cat "$_G"/.pools/* 2> /dev/null | awk -v d="/dev/$_n.eli" '$1 == d { f = 1 } END { exit !f }'; then
		echo "geli: Cannot destroy device $_n.eli (error=16)" >&2
		exit 1
	fi
	rm -f "$_G/.geli/$_key" "$_G/$_n.eli"
	;;
status)
	for _f in "$_G"/.geli/*; do
		[ -f "$_f" ] || continue
		awk '{ printf "%s.eli  ACTIVE  %s\n", $1, $1 }' "$_f"
	done
	;;
esac
exit 0

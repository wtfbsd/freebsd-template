#
# Logs its arguments to $STUB_LOG and changes nothing: the suite runs
# without root. The log must stay empty when the first-boot script
# skips its work (read-only root).

printf 'pw %s\n' "$*" >> "${STUB_LOG:-/dev/null}"
exit 0

#!/bin/sh
# chown — test stub for chown(8).
#
# Copyright (c) 2026 The wtfbsd contributors. BSD-2-Clause (see LICENSE).
#
# Logs its arguments to $STUB_LOG and changes nothing: the suite runs
# without root, so the ownership of the staged files cannot be changed
# here. What is checked is the call the build makes.

printf 'chown %s\n' "$*" >> "${STUB_LOG:-/dev/null}"
exit 0

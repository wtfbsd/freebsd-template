#!/bin/sh
# zpool — test stub for zpool(8).
#
# Copyright (c) 2026 The wtfbsd contributors. BSD-2-Clause (see LICENSE).
#
# Logs its arguments to $STUB_LOG. `zpool import -d <device>` prints
# the real import table of a pool that cannot be fully attached (the
# device is not there), which is where the pool name is read from.

printf 'zpool %s\n' "$*" >> "${STUB_LOG:-/dev/null}"

# With $STUB_GEOM (the device directory of the run, see the gpart stub)
# the stub keeps the pools that are imported, $STUB_GEOM/.pools/<pool>,
# one line "/dev/<vdev> <partition>" per device: create, import, list,
# status -P and export work on them. Every device of a created pool is
# logged as "zpool-vdev <pool> <partition>", the partition its name
# resolved to. $STUB_ZPOOL_FAIL names a pool whose create fails.
if [ -n "${STUB_GEOM:-}" ]; then
	_G=$STUB_GEOM
	_prov() { # the partition behind a device name (a label, .eli or not)
		_pn=${1%.eli}
		case $_pn in
		gpt/*)
			[ -f "$_G/.labels/${_pn#gpt/}" ] || return 1
			cat "$_G/.labels/${_pn#gpt/}"
			;;
		*) printf '%s\n' "$_pn" ;;
		esac
	}
	case $1 in
	create)
		shift
		_pool=''
		while [ $# -gt 0 ]; do
			case $1 in
			-f) ;;
			-o | -O) shift ;;
			*)
				_pool=$1
				shift
				break
				;;
			esac
			shift
		done
		if [ -f "$_G/.pools/$_pool" ]; then
			echo "cannot create '$_pool': pool already exists" >&2
			exit 1
		fi
		if [ "${STUB_ZPOOL_FAIL:-}" = "$_pool" ]; then
			echo "cannot create '$_pool': injected failure" >&2
			exit 1
		fi
		_lines=''
		for _v in "$@"; do
			case $_v in mirror | raidz1 | raidz2 | raidz3) continue ;; esac
			if [ ! -e "$_G/$_v" ] && [ ! -f "$_G/.labels/${_v#gpt/}" ]; then
				echo "cannot open '$_v': no such GEOM provider" >&2
				exit 1
			fi
			_p=$(_prov "$_v") || { echo "cannot open '$_v'" >&2; exit 1; }
			printf 'zpool-vdev %s %s\n' "$_pool" "$_p" >> "${STUB_LOG:-/dev/null}"
			_lines="$_lines/dev/$_v $_p
"
		done
		mkdir -p "$_G/.pools"
		printf '%s' "$_lines" > "$_G/.pools/$_pool"
		exit 0
		;;
	list)
		_want=''
		for _a in "$@"; do _want=$_a; done
		case $_want in list | name) _want='' ;; esac
		if [ -n "$_want" ]; then
			[ -f "$_G/.pools/$_want" ] || { echo "cannot open '$_want': no such pool" >&2; exit 1; }
			printf '%s\n' "$_want"
			exit 0
		fi
		for _f in "$_G"/.pools/*; do
			[ -f "$_f" ] && printf '%s\n' "${_f##*/}"
		done
		exit 0
		;;
	status)
		for _a in "$@"; do _want=$_a; done
		[ -f "$_G/.pools/$_want" ] || { echo "cannot open '$_want': no such pool" >&2; exit 1; }
		printf '  pool: %s\n state: ONLINE\nconfig:\n\n\tNAME STATE READ WRITE CKSUM\n\t%s ONLINE 0 0 0\n' "$_want" "$_want"
		awk '{ printf "\t  %s ONLINE 0 0 0\n", $1 }' "$_G/.pools/$_want"
		exit 0
		;;
	export)
		for _a in "$@"; do _want=$_a; done
		[ -f "$_G/.pools/$_want" ] || { echo "cannot open '$_want': no such pool" >&2; exit 1; }
		rm -f "$_G/.pools/$_want"
		exit 0
		;;
	import)
		if [ "$2" != '-d' ]; then
			for _a in "$@"; do _want=$_a; done
			mkdir -p "$_G/.pools"
			printf '/dev/vtbd0p3 vtbd0p3\n' > "$_G/.pools/$_want"
			exit 0
		fi
		;;
	esac
fi

case $1 in
import)
	if [ "$2" = '-d' ]; then
		cat <<'TABLE'
   pool: examplebsd_root
     state: ONLINE
    status: One or more devices could not be opened.
    action: Attach the missing device and online it.
   scan: none requested
 config:

	NAME                     STATE     READ WRITE CKSUM
	examplebsd_root         ONLINE       0     0     0
	  vtbd0p3               ONLINE       0     0     0

errors: No known data errors
TABLE
	fi
	;;
esac
exit 0
